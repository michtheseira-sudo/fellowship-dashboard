# Set to "true" to use realistic mock data instead of live API calls.
# Keep this true until credentials below are filled in and verified.
USE_MOCK_DATA=true

# --- HubSpot ---
# Private app token (or Service Key - see README): Settings > Integrations.
# Required scopes: crm.objects.contacts.read, crm.objects.deals.read, forms
# Note: HubSpot doesn't have a separate "meetings" scope in the picker -
# meetings access is granted via crm.objects.contacts.read. The "forms"
# scope is needed separately, for resolving which form is associated with
# a meeting (used to classify meeting completion - see
# lib/providers/hubspot.ts fetchMeetingFormAssociations).
HUBSPOT_PRIVATE_APP_TOKEN=

# The pipeline containing "Invited to enroll" / "Paid deposit" / "Paid
# installment" / "Closed won" / "Closed lost" - find it in HubSpot under
# Settings > Objects > Deals > Pipelines, check the URL for the ID.
DEAL_PIPELINE_ID=

# --- GA4 ---
# Service account JSON (base64-encoded), granted Viewer on the GA4 property.
GA4_SERVICE_ACCOUNT_JSON_BASE64=
GA4_PROPERTY_ID=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# --- Storage ---
# BLOB_READ_WRITE_TOKEN is auto-injected by Vercel once you create and
# connect a Blob store (Vercel dashboard > Storage > Create Database >
# Blob) - nothing to paste here manually. For local testing against real
# Blob storage, run `vercel env pull .env.local` after connecting it.

# --- Access protection ---
# Internal-only tool sitting at a public Vercel URL - set both to gate it
# behind HTTP Basic Auth. Leave unset for local dev (no prompt).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Cron ---
# Set in Vercel once live sync is implemented; Vercel Cron sends this as a
# bearer token automatically. Leave unset to disable the check locally.
CRON_SECRET=
